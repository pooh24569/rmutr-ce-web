<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ===================================================================
         ☕ SourceAFIS Fingerprint Matching Service
         ===================================================================
         Spring Boot + SourceAFIS — ฟรี 100% (Apache 2.0)
         ทำหน้าที่:
         1. Extract fingerprint template จาก image
         2. Match 1:1 (verify)
         3. Match 1:N (identify)
         =================================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>th.ac.rmutr</groupId>
    <artifactId>fingerprint-matcher</artifactId>
    <version>1.0.0</version>
    <name>Fingerprint Matcher Service</name>
    <description>SourceAFIS-based fingerprint matching microservice</description>

    <properties>
        <java.version>17</java.version>
        <sourceafis.version>3.18.1</sourceafis.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Web — REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- SourceAFIS — Fingerprint Matching Engine (Apache 2.0 ฟรี!) -->
        <dependency>
            <groupId>com.machinezoo.sourceafis</groupId>
            <artifactId>sourceafis</artifactId>
            <version>${sourceafis.version}</version>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
